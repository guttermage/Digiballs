pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--init--
hiscore = 0
score = 0

function load_bricks(lvl)
	bricks={}
	brick_total = 0
		--local bricks--
	local brick_w=16
	local brick_h=8
	local padding=1
	local start_x = 14
	local start_y = 20
	
	local rows = 2 + lvl
	local cols = 6
	
	for row = 0, rows-1 do
		for col = 0, cols-1 do
		
		if rnd(1) > 0.3 then
			add (bricks,{
				x=start_x + col * (brick_w + padding),
				y=start_y + row * (brick_h + padding),
				w=brick_w,
				h=brick_h,
				active=true,
				})
				
				if rnd(1) > 0.3 then
				brick_total += 1
				end
				
			end
		end
 end
end
	
	
function _init()
mode="title"
current_lvl = 1
score = 0
--paddle/player--
player = {
x=63.0,	
y=110,
speed=1
}
--ball--
ball = {
x = player.x,
y = player.y-8,

--ball velocity--
dx=0,
dy=1.5,
speed=1,
active = false
}

load_bricks(current_lvl)

--screen boundary const--
left_wall =1
right_wall = 111
top_wall = 0
bottom_wall = 112


end
-->8
--update--

function _update60()
--title screen--
if mode == "title" then

	if btnp(4) then
		mode="game"
		else
		end
	end
-- player code --
	if btn(⬅️) then
		player.x -= player.speed
		end
	if btn(➡️) then
		player.x += player.speed
		end
		
	--boundaries enforced--
	player.x=mid(left_wall, player.x, right_wall)
	
	
	--shoot da bawl--
	if btnp(5)then
	ball.active=true
	ball.dx = .66
	end
	
	if ball.active then
		ball.x+=ball.dx
		ball.y+=ball.dy
	end
	
--sets wall boundary for ball--
	
	if ball.x<=left_wall or ball.x>=right_wall then
		ball.dx*=-1
		end
	if ball.y<=top_wall then
		ball.dy*=-1
		end
		
--ball paddle collision --	
	if ball.y >= player.y 
 	and ball.x >=player.x
	 and ball.x <=player.x+16 then
		 ball.dy = -ball.dy
		 ball.y = player.y - 1
	end
	
	if ball.y>= 128 then
		ball.active=false
		mode="gameover"
	end

--ball brick collision--
for b in all(bricks) do
 if b.active then
	 if ball.x  + 2 >= b.x and ball.x - 2 <= b.x+b.w and
		 		ball.y + 2 >= b.y and ball.y - 2 <= b.y +b.h then
		 	
		 	ball.dy = -ball.dy
		 	b.active = false
		 	score += 1
		 	if score > hiscore then
		 		hiscore = score
		 	end
		end
 end
end	



--gameover--
if mode == "gameover" and btnp(4) then mode = "game"
	_init()
end

end

-->8
--draw--

function _draw()

cls()

--title screen--

if mode=="title" then
	print("\fbdigi-balls",45,14)
	print("press z to start",32,60,8)
	
--pressing z to draw game--	

	else
		map()	
		spr(1,player.x,player.y,2,1)
		
		--draw brick pattern--
		
	for b in all(bricks) do
		if b.active then
			spr(6, b.x, b.y, 2, 1)
			end
		end
	end


--draw ball--		
		if ball.active==true then
		spr(5,ball.x,ball.y)
	end

--counter--
print(score,6,5,7) 
--restart screen--
	if mode == "gameover" then
	cls()
	print("\^wgame over",30,50)
	print("z to restart",43,60)
	print("high score: ",6,5,7)
	print(hiscore,50,5,7)
	end
end
