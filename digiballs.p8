pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--init--
hiscore = 0
score = 0
change_timer = 0

function load_bricks(lvl)
	bricks={}
	brick_total = 0
		--local bricks--
	local brick_w=16
	local brick_h=8
	local padding=1
	local start_x = 14
	local start_y = 20
	
	local rows = min(2 + lvl,6)
	local cols = 6
	
	for row = 0, rows-1 do
		for col = 0, cols-1 do
		
		if rnd(1) > 0.3 then
			add (bricks,{
				x=start_x + col * (brick_w + padding),
				y=start_y + row * (brick_h + padding),
				w=brick_w,
				h=brick_h,
				active=true,
				})
				brick_total += 1
				end
			end
		end
end
	
	
function _init()
mode="title"
current_lvl = 1
score = 0


--paddle/player--
player = {
x=63.0,	
y=110,
dx=1
}
--ball--
ball = {
x = player.x,
y = player.y-8,
attached = true,
--ball velocity--
dx=0,
dy=-1.5,
speed=1,
active = false
}

load_bricks(current_lvl)

--screen boundary const--
left_wall =1
right_wall = 111
top_wall = 0
bottom_wall = 112


end
-->8
--update--

function _update60()
--title screen--
if mode == "title" then

	if btnp(4) then
	
		mode="pregame"
		else
		end
	end
-- player code --
	if btn(⬅️) then
		player.x -= player.dx
		end
	if btn(➡️) then
		player.x += player.dx
		end
		
	--boundaries enforced--
	player.x=mid(left_wall, player.x, right_wall)
	
	
	--shoot da bawl--
	if btnp(5) and mode =="pregame" then
	mode = "game"
	ball.attached=false
	ball.active=true
	ball.dx = .35
	ball.dy = -1.5
	end

		
	if ball.attached then
		ball.x = player.x+4
		ball.y = player.y-4
	end
if ball.active and not ball.attached then
	ball.x += ball.dx
	ball.y += ball.dy
	
	--ball speed cap--
	ball.dy = mid(-2.0, ball.dy, 2.0)
	ball.dx = mid(-1.5, ball.dx, 1.5)
end
	
--sets wall boundary for ball--
	
	if ball.x<=left_wall or ball.x>=right_wall then
		ball.dx*=-1
		end
	if ball.y<=top_wall then
		ball.dy*=-1
		end
		
--ball paddle collision --	
	if ball.y >= player.y - 8
 	and ball.x >=player.x
	 and ball.x <=player.x+16 then
		 ball.dy = -ball.dy
		 ball.y = player.y - 8
		 
		 local hit_spot = ball.x - (player.x + 8)
		 
		 ball.dx = hit_spot * 0.10
		 sfx(0)
	end
	
	if ball.y>= 128 then
		ball.active=false
		mode="gameover"
	end

--ball brick collision--
for b in all(bricks) do
 if b.active then
	 if ball.x  + 1 >= b.x and ball.x - 1 <= b.x+b.w and
		 		ball.y + 1 >= b.y and ball.y - 1 <= b.y +b.h then
		 		
		--axis reactivity for the ball-- 	
		 	if (ball.x - ball.dx) + 1 < b.x or (ball.x - ball.dx) - 1 > b.x + b.w then
		 		ball.dx *=-1
		 	else
		 		ball.dy *= -1
		 	end
		 	
		 	
		 	b.active = false
		 	score += 1
		 	brick_total -= 1
		 	sfx(1)
		 	
		 	if score > hiscore then
		 		hiscore = score
		 	end
		  
		  break
		end
 end
end	

--change level--
if brick_total == 0 and mode == "game" then
	mode = "transition"
	change_timer = 0
	sfx(2)
end
if mode == "transition" then
	change_timer += 1
	
	if change_timer == 30 then
	current_lvl += 1
	load_bricks(current_lvl)
	ball.active = false
	ball.attached=true
	ball.x = player.x
	ball.y = player.y - 6
	end

	if change_timer >= 180 then
		mode = "pregame"
		change_timer = 0
		end
end

--gameover--
if mode == "gameover" and btnp(4) then mode = "game"
	_init()
end

end

-->8
--draw--

function m_bgrnd()
local rainbow = flr(time() * 2.5) % 16
	local wave_speed = 0.5
		local wave_height = 3
	-- horizontalcoords--	
		for i=0, 128, 16 do
			local old_x = 0
			local old_y = i
	--vertical coords--
	for i = 0 , 128, 16 do
		local old_x = i
		local old_y = 0
		
	--vertical wave logic--
		for y=0, 128, 8 do
			local wave = sin(time() * wave_speed + y/40) * wave_height
			local current_x = i + wave
			
			line(old_x,old_y,current_x,y,rainbow)
			
			old_x = current_x
			old_y = y
		end
end			
			-- horizontal wave logic --
			for x=0, 128, 8 do
			local wave = sin(time() * wave_speed + x/40) * wave_height
			local current_y = i + wave
			--last point to new point--			 
			line(old_x,old_y,x,current_y,rainbow)
			
			old_x=x
			old_y=current_y
			end
	end
rect(0,0,127,127)
end


function _draw()

cls(0)

--title screen--

if mode=="title" then
	cls()
	m_bgrnd()
	rect(40,40,89,55,11)
	print("\fbdigi-balls",45,45)
	local bounce = sin(time()) * 5
	print("press z to start",34,68+bounce)
	local bounce = sin(time()) * 7
	print("and x to shoot!", 36,75+bounce)
	
--pressing z to draw game background--	

	else
		local wave_speed = 0.5
		local wave_height = 3
		
	-- horizontalcoords--	
		for i=0, 128, 16 do
			local old_x = 0
			local old_y = i
			
	--vertical coords--
	for i = 0 , 128, 16 do
		local old_x = i
		local old_y = 0
		
	--vertical wave logic--
		for y=0, 128, 8 do
			local wave = sin(time() * wave_speed + y/40) * wave_height
			local current_x = i + wave
			
			line(old_x,old_y,current_x,y,11)
			
			old_x = current_x
			old_y = y
		end
end			
			-- horizontal wave logic --
			for x=0, 128, 8 do
			local wave = sin(time() * wave_speed + x/40) * wave_height
			local current_y = i + wave
			--last point to new point--			 
			line(old_x,old_y,x,current_y,11)
			
			old_x=x
			old_y=current_y
			end
	end
	
	rect(0,0,127,127)
	
		spr(1,player.x,player.y-6,2,1)
		
		--draw brick pattern--
		
	for b in all(bricks) do
		if b.active then
			spr(6, b.x, b.y, 2, 1)
			
			--counter--
local rainbow = flr(time() * 4) % 16			
print(score,5,5,7)
			end
		end
	end

if brick_total == 0 then
 cls()
 print("press z to continue",32,60,8)
 end

	--draw ball--

	if ball.active==true then
		spr(5,ball.x,ball.y)
	end
	
--restart screen--

	if mode == "gameover" then
	cls()
	m_bgrnd()
	print("game over",50,45,11)
	print("z to restart",43,60)
	print("high score: ",6,5,7)
	print(hiscore,50,5,7)
	end
	
if mode == "transition" then
	cls()	
	m_bgrnd()
	print("level "..current_lvl, 50, 50, 7)
	end
	
end
